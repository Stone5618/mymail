# MyMail Go 后端环境变量配置
# P1-20 修复：用占位符而非 $(openssl rand -hex 8)（shell 不展开）
# 复制此文件为 .env 并替换所有 CHANGE_ME 值

# ===== 基本信息 =====
ENV=dev
DEBUG=true

# 服务器
PORT=3000
HOST=0.0.0.0

# ===== 域名（必填） =====
DOMAIN=your-domain.com
MAIL_HOST=mail.your-domain.com

# ===== JWT（P0-8：必须设置 32+ 字符随机串） =====
# 生成命令：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHARS_OR_MORE
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=720h

# ===== 数据库 =====
DB_PATH=./data/mymail.db

# ===== 邮件存储 =====
MAILDIR_PATH=./data/maildir
ATTACHMENT_PATH=./data/attachments
MAX_ATTACHMENT_SIZE=26214400

# ===== 管理员（必填） =====
ADMIN_USERNAME=admin
# 生成命令：openssl rand -hex 16
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
ADMIN_EMAIL=admin@your-domain.com

# ===== SMTP =====
SMTP_PORT=25
SMTP_SEND_HOST=postfix
SMTP_SEND_PORT=587
# 外发 SMTP 认证（如 postfix 启用 SASL，填入；否则留空）
SMTP_SEND_USERNAME=
SMTP_SEND_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TLS_CERT=
SMTP_TLS_KEY=
# SMTP 连接限流（每 IP 单位窗口内最大连接数）
SMTP_MAX_CONNECTIONS_PER_IP=10
SMTP_RATE_WINDOW_MS=60000

# ===== 灰名单 =====
GREYLIST_DELAY_MS=300000
GREYLIST_TTL_MS=3600000

# ===== 限流 =====
RATE_LIMIT_MAX=100
SEND_RATE_LIMIT_PER_MIN=10

# ===== 反垃圾（阶段 4） =====
SPAM_THRESHOLD=10
SPAM_SUSPICIOUS_THRESHOLD=5
SPF_ENABLED=true
SPF_MAX_DEPTH=10
DNSBL_ENABLED=true
# 逗号分隔的 DNSBL zone 列表
DNSBL_ZONES=zen.spamhaus.org,bl.spamcop.net,b.barracudacentral.org
DNSBL_QUERY_TIMEOUT_MS=3000
SPF_QUERY_TIMEOUT_MS=3000

# ===== 出站 SMTP 熔断器（gobreaker） =====
SMTP_CIRCUIT_BREAKER_ENABLED=true
SMTP_CIRCUIT_BREAKER_MAX_REQUESTS=5
SMTP_CIRCUIT_BREAKER_INTERVAL_MS=60000
SMTP_CIRCUIT_BREAKER_TIMEOUT_MS=30000
SMTP_CIRCUIT_BREAKER_FAILURE_RATIO=0.6
SMTP_CIRCUIT_BREAKER_MIN_REQUESTS=10

# ===== 出站 SMTP 重试（backoff） =====
SMTP_RETRY_ENABLED=true
SMTP_RETRY_MAX_ATTEMPTS=3
SMTP_RETRY_INITIAL_INTERVAL_MS=500
SMTP_RETRY_MAX_INTERVAL_MS=10000
SMTP_RETRY_MAX_ELAPSED_TIME_MS=60000

# ===== 规则引擎（P1-7：ReDoS 防护） =====
RULES_MAX_PATTERN_LENGTH=500
RULES_COMPILE_TIMEOUT_MS=2000

# ===== CORS（P1-2：白名单，逗号分隔） =====
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://mail.your-domain.com

# ===== 可观测性 =====
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PATH=/metrics
TRACING_ENABLED=false
TRACING_ENDPOINT=
TRACING_SAMPLE_RATE=0.1

# ===== 审计 =====
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365

# ===== 特性开关 =====
FEATURE_SPAM_FILTER=true
FEATURE_WS_NOTIFY=true
FEATURE_GREYLIST=true
FEATURE_API_KEY=true
FEATURE_RULES=true
FEATURE_AUDIT=true
FEATURE_REGISTRATION=true
