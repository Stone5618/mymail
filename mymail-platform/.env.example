# Server
PORT=3000
HOST=0.0.0.0

# Domain
DOMAIN=your-domain.com
MAIL_HOST=mail.your-domain.com

# DuckDNS
DUCKDNS_TOKEN=your-duckdns-token
DUCKDNS_DOMAIN=your-subdomain

# JWT (change in production!)
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=30d

# Database
DB_PATH=./data/mymail.db

# Mail
MAILDIR_PATH=./data/maildir
ATTACHMENT_PATH=./data/attachments
MAX_ATTACHMENT_SIZE=26214400

# Admin (pre-set)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_$(openssl rand -hex 8)
ADMIN_EMAIL=admin@your-domain.com

# SMTP
SMTP_PORT=25
# Outbound SMTP relay (Postfix container or external relay)
SMTP_SEND_HOST=postfix
SMTP_SEND_PORT=587
# Set to false for internal Postfix (self-signed cert), true for external relay
SMTP_TLS_REJECT_UNAUTHORIZED=false

# SMTP TLS (for receiving)
SMTP_TLS_CERT=
SMTP_TLS_KEY=

# Outbound SMTP TLS
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Greylisting
GREYLIST_DELAY_MS=300000
GREYLIST_TTL_MS=3600000

# SMTP rate limiting
SMTP_MAX_CONNECTIONS_PER_IP=10
SMTP_RATE_WINDOW_MS=60000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SEND_RATE_LIMIT_PER_MIN=10

# Spam Filter
SPAM_FILTER_ENABLED=true
SPAM_THRESHOLD=10
SPAM_SUSPICIOUS_THRESHOLD=5
DNSBL_ENABLED=true
SPF_ENABLED=true
