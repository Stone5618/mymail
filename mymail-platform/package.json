{
  "name": "mymail-platform",
  "version": "1.0.0",
  "description": "Self-hosted email platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify",
    "watch:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch",
    "db:init": "node scripts/init-db.js",
    "db:migrate": "knex migrate:latest",
    "db:migrate:rollback": "knex migrate:rollback",
    "db:migrate:make": "knex migrate:make",
    "dkim:gen": "node scripts/gen-dkim.js",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "archiver": "^7.0.0",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.9",
    "mailparser": "^3.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "smtp-server": "^3.13.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "jest": "^30.3.0",
    "postcss": "^8.4.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0"
  }
}
